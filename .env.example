# LÉXORA — Configuração de Ambiente
APP_NAME=lexora
APP_ENV=development
LOG_LEVEL=INFO

# Banco de Dados (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql+asyncpg://lexora_user:lexora_password@localhost:5432/lexora_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Armazenamento (Cloudflare R2 / Local)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=lexora-storage

# LLM Providers (OpenAI / Gemini / Cloudflare Workers AI)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_WORKERS_AI_API_TOKEN=

# Modelos de Embedding e Reranker
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=text-embedding-3-small
